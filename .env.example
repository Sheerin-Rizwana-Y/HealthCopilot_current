# Copy this file to .env in the HealthCopilot project root and change secrets.
APP_ENV=development
APP_NAME=Lifora API
API_PREFIX=/api/v1

# Local MongoDB. For MongoDB Atlas, replace with your private connection URI.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=lifora_db

# Security: replace both before use beyond local demo.
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
ACCESS_TOKEN_EXPIRE_MINUTES=720
BOOTSTRAP_ADMIN_USERNAME=caregiver@example.com
BOOTSTRAP_ADMIN_PASSWORD=Sheerin@11
SEED_DEMO_DATA=true

# Comma-separated frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Device token used by the ESP32/simulator endpoint.
DEVICE_INGEST_TOKEN=replace-this-device-token

# Groq is opt-in. Leave false until you have configured the key and reviewed privacy.
GROQ_API_KEY=your_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
ALLOW_CLOUD_LLM=false
ALLOW_REAL_DATA_TO_CLOUD_LLM=false

# By default, uploads must be the existing synthetic demo PDFs.
ALLOW_REAL_REPORT_UPLOADS=false
MAX_UPLOAD_MB=10

# Illustrative prototype thresholds only; not clinically validated.
DEMO_HR_MIN=40
DEMO_HR_MAX=130
DEMO_SPO2_LOW=90
DEMO_TEMPERATURE_HIGH_C=39.5

# Emergency monitoring (prototype defaults only; NOT clinically validated).
EMERGENCY_MONITOR_INTERVAL_SECONDS=5
SENSOR_STALE_AFTER_SECONDS=60
INACTIVITY_THRESHOLD_SECONDS=120
INACTIVITY_RESPONSE_TIMEOUT_SECONDS=30
LOCAL_ALARM_ACTIVE_SECONDS=300
LOCAL_ALARM_SNOOZE_SECONDS=900
WARNING_ALARM_ACTIVE_SECONDS=300
VITAL_PERSISTENCE_SECONDS=30
TREND_WINDOW_SECONDS=300
HR_TREND_CHANGE_BPM=20
SPO2_TREND_DROP_PERCENT=3.0
TEMP_TREND_RISE_C=1.0
MOVEMENT_THRESHOLD=0.15
WARNING_HR_LOW=50
WARNING_HR_HIGH=120
CRITICAL_HR_LOW=40
CRITICAL_HR_HIGH=140
WARNING_SPO2_LOW=92
CRITICAL_SPO2_LOW=88
WARNING_TEMP_HIGH_C=38.0
CRITICAL_TEMP_HIGH_C=40.0
SMS_RETRY_SECONDS=300
CALL_RETRY_SECONDS=900
MAX_SMS_ATTEMPTS=5
MAX_CALL_ATTEMPTS=3

# Required to store emergency phone numbers encrypted in MongoDB.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key secret and stable; losing it makes saved contact numbers unreadable.
EMERGENCY_CONTACT_ENCRYPTION_KEY=76yQt8b1wDWCv-fRGEkHYvuEM4NDVv_hR00UwbTYpU=

# Optional Twilio provider. Keep disabled until a consented test number is verified.
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
EMERGENCY_SMS_ENABLED=false
EMERGENCY_CALLS_ENABLED=false
